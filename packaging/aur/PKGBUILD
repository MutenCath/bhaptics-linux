# Maintainer: MutenCath <anthropic@kaczki.org>
pkgname=bhaptics-linux-git
pkgver=0.0.1.r0.g0000000
pkgrel=1
pkgdesc="bHaptics TactSuit Player emulator: SDK1/SDK2/OSC/audio-to-haptics over BLE, no Windows Player needed"
arch=(any)
url="https://github.com/MutenCath/bhaptics-linux"
license=(GPL-3.0-or-later)
depends=(python python-websockets python-bleak python-numpy python-evdev
         bluez libpulse openssl)
makedepends=(git dotnet-sdk)
optdepends=('pipewire-pulse: audio-to-haptics capture (or pulseaudio)'
            'dotnet-sdk: rebuild the VestRumble generic Unity plugin')
provides=(bhaptics-linux)
conflicts=(bhaptics-linux)
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$pkgname/plugin/VestRumble"
  dotnet build -c Release
}

package() {
  cd "$pkgname"
  install -Dm644 player_daemon.py "$pkgdir/usr/lib/bhaptics-linux/player_daemon.py"
  install -Dm644 ui.html "$pkgdir/usr/lib/bhaptics-linux/ui.html"
  install -Dm755 tools/proton-sdk2-setup.sh \
    "$pkgdir/usr/lib/bhaptics-linux/tools/proton-sdk2-setup.sh"
  install -Dm755 tools/proton-wrap.sh \
    "$pkgdir/usr/lib/bhaptics-linux/tools/proton-wrap.sh"
  install -Dm644 plugin/VestRumble/bin/Release/net46/VestRumble.dll \
    "$pkgdir/usr/lib/bhaptics-linux/plugin/VestRumble/bin/Release/net46/VestRumble.dll"
  install -Dm755 vestctl.py "$pkgdir/usr/bin/vestctl"
  install -Dm644 packaging/bhaptics-daemon.service \
    "$pkgdir/usr/lib/systemd/user/bhaptics-daemon.service"
  install -Dm644 packaging/bhaptics-vest.desktop \
    "$pkgdir/usr/share/applications/bhaptics-vest.desktop"
  install -Dm644 packaging/vestctl.fish \
    "$pkgdir/usr/share/fish/vendor_completions.d/vestctl.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
