# Local PKGBUILD — run `makepkg -si` inside packaging/ to install system-wide
# (alternative to ./install.sh; disable the user unit from install.sh first:
#  systemctl --user disable --now bhaptics-daemon)
pkgname=bhaptics-linux
pkgver=0.0.2
pkgrel=1
pkgdesc="bHaptics TactSuit Player emulator: SDK1/SDK2/OSC/audio -> BLE, no Windows Player"
arch=(any)
license=(GPL-3.0-or-later)
depends=(python python-websockets python-bleak python-numpy python-evdev bluez libpulse openssl)
optdepends=('python-pystray: system tray quick control (bhaptics-tray)'
            'python-pillow: system tray icon')

package() {
  local src
  src="$(realpath "$startdir/..")"
  install -Dm644 "$src/player_daemon.py" "$pkgdir/usr/lib/bhaptics-linux/player_daemon.py"
  install -Dm644 "$src/ui.html" "$pkgdir/usr/lib/bhaptics-linux/ui.html"
  install -Dm755 "$src/tray.py" "$pkgdir/usr/bin/bhaptics-tray"
  install -Dm755 "$src/tools/proton-sdk2-setup.sh" \
    "$pkgdir/usr/lib/bhaptics-linux/tools/proton-sdk2-setup.sh"
  install -Dm755 "$src/tools/proton-wrap.sh" \
    "$pkgdir/usr/lib/bhaptics-linux/tools/proton-wrap.sh"
  local dll="$src/plugin/VestRumble/bin/Release/net46/VestRumble.dll"
  if [[ -f "$dll" ]]; then
    install -Dm644 "$dll" \
      "$pkgdir/usr/lib/bhaptics-linux/plugin/VestRumble/bin/Release/net46/VestRumble.dll"
  fi
  install -Dm755 "$src/vestctl.py" "$pkgdir/usr/bin/vestctl"
  install -Dm644 "$src/packaging/bhaptics-daemon.service" \
    "$pkgdir/usr/lib/systemd/user/bhaptics-daemon.service"
  install -Dm644 "$src/packaging/bhaptics-vest.desktop" \
    "$pkgdir/usr/share/applications/bhaptics-vest.desktop"
  install -Dm644 "$src/packaging/bhaptics-tray.desktop" \
    "$pkgdir/usr/share/applications/bhaptics-tray.desktop"
  install -Dm644 "$src/packaging/vestctl.fish" \
    "$pkgdir/usr/share/fish/vendor_completions.d/vestctl.fish"
  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
